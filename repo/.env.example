JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_DISPATCHER_PASSWORD=change-this-dispatcher-password
BOOTSTRAP_PASSENGER_PASSWORD=change-this-passenger-password
BOOTSTRAP_ADMIN_RECOVERY_CODE=change-this-admin-recovery-code
